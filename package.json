{
  "name": "umamidash",
  "version": "0.1.0",
  "description": "Realtime analytics dashboard for self-hosted Umami instances",
  "author": "Charles Jones",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/charlesjones-dev/umamidash.git"
  },
  "keywords": [
    "umami",
    "analytics",
    "dashboard",
    "realtime",
    "vue",
    "sse"
  ],
  "type": "module",
  "scripts": {
    "setup:doppler": "node scripts/setup-doppler.js",
    "dev": "doppler run -- concurrently \"node server.js\" \"vite\"",
    "dev:client": "doppler run -- vite",
    "dev:server": "doppler run -- node server.js",
    "dev:worker": "vite build && wrangler dev --env=\"\"",
    "build": "vite build",
    "start": "node server.js",
    "deploy:worker": "vite build && wrangler deploy --env=\"\"",
    "stub:umami": "node scripts/stub-umami.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.server.json && tsc -p tsconfig.worker.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "express": "^4.21.2",
    "jose": "^6.2.17",
    "leaflet": "^1.9.4",
    "lucide-vue-next": "^0.474.0",
    "reka-ui": "^2.8.0",
    "tailwind-merge": "^3.5.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.7.0",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@tailwindcss/vite": "^4.0.7",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3",
    "vite": "^6.4.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.160.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
