{
  // worker/ and core/ against the Workers runtime types, so core/ stays
  // free of Node-only APIs.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["worker/**/*.ts", "core/**/*.ts", "test/worker/**/*.ts", "test/stub-umami.ts"]
}
